# ── Environment ──────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=True

# ── Database (Supabase hosted PostgreSQL) ─────────────────────────────────────
# Format: postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
DATABASE_URL=

# ── Supabase (get these from https://supabase.com → Project → Settings → API) ──
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_KEY=

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# ── Redis (auto-configured via Docker Compose) ────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000
ALLOWED_CREDENTIALS=true

# ── API metadata ─────────────────────────────────────────────────────────────
API_TITLE=FestSync API
API_VERSION=0.1.0
API_DESCRIPTION=AI-powered event planning platform

# ── AI Provider ───────────────────────────────────────────────────────────────
# Options: mock | openai | gemini
# "mock" works with no API key — great for local dev
AI_PROVIDER=mock
OPENAI_API_KEY=
GEMINI_API_KEY=

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
